# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL Target & Ephemeral Rehearsal DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/schemasentry_test

# TrueForge Agent Runtime Configuration
# - Local / Docker Container: http://127.0.0.1:8790
# - Remote Hosted Deployment: https://<your-remote-trueforge-instance>
TRUEFORGE_BASE_URL=http://127.0.0.1:8790

# Auto-spawn local TrueForge daemon process (true for local/Docker, false if using remote TrueForge)
TRUEFORGE_AUTO_SPAWN_DAEMON=true

# TrueForge Authentication (Bearer token for secured/remote deployments)
TRUEFORGE_TOKEN=

# Optional: Registered Agent Name in TrueForge Registry (leave blank to use inline agent spec)
TRUEFORGE_AGENT_NAME=

# Model Configuration for TrueForge Inline Agent Specification
TRUEFORGE_MODEL_PROVIDER=google-gemini
TRUEFORGE_MODEL_NAME=google-gemini/gemini-3.6-flash

# Model Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Daytona Cloud Sandbox Configuration (for isolated container compute rehearsal)
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=
