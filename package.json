{
  "name": "orvexa-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Orvexa - Production-Grade Full-Stack AI Agent Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/dist/index.js",
    "dev": "concurrently -n \"server,web\" -c \"cyan,magenta\" \"npm run dev -w @orvexa/server\" \"npm run dev -w @orvexa/web\"",
    "dev:server": "npm run dev -w @orvexa/server",
    "dev:web": "npm run dev -w @orvexa/web",
    "build": "npm run build -w @orvexa/shared && npm run build -w @orvexa/server && npm run build -w @orvexa/web",
    "clean": "npm run clean -w @orvexa/shared && npm run clean -w @orvexa/server && npm run clean -w @orvexa/web",
    "test": "npm run test:unit -w @orvexa/server && npm run test -w @orvexa/web",
    "test:unit": "npm run test:unit -w @orvexa/server",
    "test:integration": "npm run test:integration -w @orvexa/server",
    "test:all": "npm run test:all -w @orvexa/server && npm run test -w @orvexa/web",
    "verify:db": "npm run verify:db -w @orvexa/server",
    "verify:trueforge": "npm run verify:trueforge -w @orvexa/server",
    "verify:mcp": "npm run verify:mcp -w @orvexa/server",
    "verify:sandbox": "npm run verify:sandbox -w @orvexa/server",
    "verify:rehearsal": "npm run verify:rehearsal -w @orvexa/server",
    "verify:migration-rehearsal": "npm run verify:migration-rehearsal -w @orvexa/server",
    "verify:live-migration": "npm run verify:live-migration -w @orvexa/server",
    "trueforge:start": "node node_modules/@truefoundry/trueforge/dist/cli.js --port 8790",
    "docker:db:up": "docker compose up -d",
    "docker:db:down": "docker compose down",
    "lint": "eslint apps packages",
    "typecheck": "npm run typecheck -w @orvexa/shared && npm run typecheck -w @orvexa/server && npm run typecheck -w @orvexa/web",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "postinstall": "node scripts/patch-kysely.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@truefoundry/trueforge": "^0.1.4",
    "@types/node": "^22.13.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=10.0.0"
  }
}
